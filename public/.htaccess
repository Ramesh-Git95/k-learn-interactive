Options -MultiViews
RewriteEngine On

# Canonicalize www -> non-www (301) so search engines see a single domain.
# Without this, https://www.korean-learn.com serves a duplicate of the whole
# site and Google flags "Duplicate without user-selected canonical".
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Serve the prerendered page for a section when one exists, so that /vocabulary
# returns vocabulary.html rather than the generic shell. scripts/prerender.cjs
# writes those files during the build; they are the same app with the section's
# own title, description and canonical already in the HTML.
#
# This matters for link previews. Facebook, WhatsApp, Slack, X, Reddit and
# iMessage read the raw HTML and never run JavaScript, so the metadata the app
# sets at runtime is invisible to them — every shared section link unfurled as
# the homepage. It only fires when the .html file is actually there, so a
# section without a prerendered page simply falls through to the rule below.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# index.html must never be cached — browsers must always fetch the latest version
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# Hashed assets (JS/CSS built by Vite) are safe to cache for 1 year
# Their filenames change on every build so stale versions are never served
<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
